rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ADMIN";
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'role', 'createdAt']) && 
             data.id is string && data.id.size() <= 64 &&
             data.email is string && data.email.size() <= 128 &&
             data.role in ['ADMIN', 'USER'] &&
             data.createdAt is int;
    }

    function isValidReport(data) {
      return data.keys().hasAll(['userId', 'userEmail', 'status', 'createdAt', 'updatedAt']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.userEmail is string && data.userEmail.size() <= 256 &&
             data.status in ['PENDING', 'PROSES', 'SELESAI', 'GAGAL', 'BATAL'] &&
             data.createdAt is number &&
             data.updatedAt is number &&
             (!('googleLama' in data) || (data.googleLama is string && data.googleLama.size() <= 256)) &&
             (!('ffId' in data) || (data.ffId is string && data.ffId.size() <= 256)) &&
             (!('message' in data) || (data.message is string && data.message.size() <= 2000)) &&
             (!('recoveredPassword' in data) || (data.recoveredPassword is string && data.recoveredPassword.size() <= 256)) &&
             (!('userFeedback' in data) || data.userFeedback in ['BERHASIL', 'GAK_BISA']);
    }

    // Collection Rules
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if (isOwner(userId) && isValidUser(incoming()) && 
                         incoming().diff(existing()).affectedKeys().hasOnly(['email', 'password', 'updatedAt']) &&
                         incoming().role == existing().role) || 
                       isAdmin();
    }

    match /reports/{reportId} {
      allow get: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidReport(incoming());
      
      allow update: if (
        (isAdmin() && isValidReport(incoming())) ||
        (isSignedIn() && existing().userId == request.auth.uid && 
         isValidReport(incoming()) && 
         incoming().userId == existing().userId && (
          // Action: User Feedback / Cancel
          incoming().diff(existing()).affectedKeys().hasOnly(['userFeedback', 'status', 'message', 'updatedAt'])
        ))
      );
    }
  }
}
