rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ADMIN") ||
             request.auth.token.email == "kytyg800@gmail.com";
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'role', 'createdAt']) && 
             data.id is string && data.id.size() <= 64 &&
             data.email is string && data.email.size() <= 128 &&
             data.role in ['ADMIN', 'USER'] &&
             data.createdAt is int;
    }

    function isValidReport(data) {
      return data.keys().hasAll(['userId', 'userEmail', 'status', 'createdAt', 'updatedAt']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.userEmail is string && data.userEmail.size() <= 256 &&
             data.status in ['PENDING', 'PROSES', 'SELESAI', 'GAGAL', 'BATAL'] &&
             data.createdAt is number &&
             data.updatedAt is number &&
             (!('googleLama' in data) || (data.googleLama is string && data.googleLama.size() <= 256)) &&
             (!('ffId' in data) || (data.ffId is string && data.ffId.size() <= 256)) &&
             (!('message' in data) || (data.message is string && data.message.size() <= 2000)) &&
             (!('recoveredPassword' in data) || (data.recoveredPassword is string && data.recoveredPassword.size() <= 256)) &&
             (!('userFeedback' in data) || data.userFeedback in ['BERHASIL', 'GAK_BISA']);
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['userId', 'userEmail', 'text', 'createdAt', 'role']) &&
             data.keys().size() == 5 &&
             data.userId == request.auth.uid &&
             data.userEmail is string && data.userEmail.size() <= 256 &&
             data.text is string && data.text.size() <= 1000 &&
             data.createdAt is number &&
             data.role in ['ADMIN', 'USER'] &&
             (data.role != 'ADMIN' || isAdmin());
    }

    function isValidBind(data) {
      return data.keys().hasAll(['id', 'accountName', 'emailBind', 'status', 'createdAt']) &&
             data.id is string && data.id.size() <= 64 &&
             data.accountName is string && data.accountName.size() <= 256 &&
             data.emailBind is string && data.emailBind.size() <= 256 &&
             data.status in ['SECURE', 'PENDING', 'COMPROMISED'] &&
             data.createdAt is number &&
             (!('accountId' in data) || (data.accountId is string && data.accountId.size() <= 64)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000));
    }

    // Collection Rules
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if (isOwner(userId) && isValidUser(incoming()) && 
                         incoming().diff(existing()).affectedKeys().hasOnly(['email', 'password', 'updatedAt']) &&
                         incoming().role == existing().role) || 
                       isAdmin();
    }

    match /reports/{reportId} {
      allow get: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow list: if isSignedIn() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid || 
        (resource.data.googleLama is string && resource.data.googleLama.size() > 0)
      );
      
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidReport(incoming());
      
      allow update: if (
        (isAdmin() && isValidReport(incoming())) ||
        (isSignedIn() && existing().userId == request.auth.uid && 
         isValidReport(incoming()) && 
         incoming().userId == existing().userId && (
          // Action: User Feedback / Cancel
          incoming().diff(existing()).affectedKeys().hasOnly(['userFeedback', 'status', 'message', 'updatedAt'])
        ))
      );
    }

    match /messages/{messageId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidMessage(incoming()) && isValidId(messageId);
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow write: if isAdmin();
    }

    match /bindings/{bindId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidBind(incoming());
      allow update: if isAdmin() && isValidBind(incoming());
      allow delete: if isAdmin();
    }
  }
}
