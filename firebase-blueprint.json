{
  "entities": {
    "User": {
      "title": "User",
      "description": "App user or admin profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "password": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "USER"] },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "email", "password", "role", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "Account recovery report",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "googleLama": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "PROSES", "SELESAI", "GAGAL", "BATAL"] },
        "recoveredPassword": { "type": "string" },
        "userFeedback": { "type": "string", "enum": ["BERHASIL", "GAK_BISA"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "message": { "type": "string" }
      },
      "required": ["id", "userId", "userEmail", "googleLama", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "User reports"
    }
  }
}
