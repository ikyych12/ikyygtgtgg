{
  "entities": {
    "User": {
      "title": "User",
      "description": "App user or admin profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "password": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "USER"] },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "email", "password", "role", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "Account recovery report",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "googleLama": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "PROSES", "SELESAI", "GAGAL", "BATAL"] },
        "recoveredPassword": { "type": "string" },
        "userFeedback": { "type": "string", "enum": ["BERHASIL", "GAK_BISA"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "message": { "type": "string" }
      },
      "required": ["id", "userId", "userEmail", "googleLama", "status", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Global chat message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "USER"] },
        "text": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "userEmail", "text", "createdAt"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Global application settings",
      "type": "object",
      "properties": {
        "chatEnabled": { "type": "boolean" }
      },
      "required": ["chatEnabled"]
    },
    "AccountBind": {
      "title": "AccountBind",
      "description": "Account binding information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "accountId": { "type": "string" },
        "accountName": { "type": "string" },
        "emailBind": { "type": "string" },
        "location": { "type": "string" },
        "device": { "type": "string" },
        "status": { "type": "string", "enum": ["SECURE", "PENDING", "COMPROMISED"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "accountName", "emailBind", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "User reports"
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Global chat messages"
    },
    "/settings/{settingId}": {
      "schema": "AppSettings",
      "description": "Global settings"
    },
    "/bindings/{bindId}": {
      "schema": "AccountBind",
      "description": "Account binding records"
    }
  }
}
