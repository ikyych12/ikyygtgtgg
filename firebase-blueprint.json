{
  "entities": {
    "User": {
      "title": "User",
      "description": "App user or admin profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "password": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "USER"] },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "email", "password", "role", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "Account recovery report",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "ffId": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "PROSES", "SELESAI"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "screenshotUrl": { "type": "string" },
        "isScreenshotConfirmed": { "type": "boolean" },
        "message": { "type": "string" },
        "oldEmail": { "type": "string" },
        "newEmail": { "type": "string" },
        "verificationCode": { "type": "string" },
        "userEnteredCode": { "type": "string" }
      },
      "required": ["id", "userId", "userEmail", "ffId", "reason", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "User reports"
    }
  }
}
